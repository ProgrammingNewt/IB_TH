# Keys for the model providers in config.yaml. Set at least one. A provider without a key is skipped.

# model_provider_1 (DeepSeek)
DEEPSEEK_API_KEY=

# model_provider_2 (Cerebras)
CEREBRAS_API_KEY=

# Set to 1 to allow the local model (Ollama) as the last fallback.
# Start Ollama first and pull a tool-calling model: `ollama pull qwen2.5:7b`
LOCAL_MODEL=0
